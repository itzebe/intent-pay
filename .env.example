# ---------------------------------------------------------------------------
# Intent Pay — environment configuration
#
# Copy to `.env.local` and fill in what you have. Every value is optional: the
# app degrades gracefully (see the fallback notes) and never fakes data when a
# provider is missing.
# ---------------------------------------------------------------------------

# --- Site --------------------------------------------------------------------
# Canonical origin this deployment advertises (metadata/canonical URLs, OG
# image, robots.txt, sitemap.xml). Defaults to the production Vercel domain.
NEXT_PUBLIC_SITE_URL=

# --- Monad -------------------------------------------------------------------
# Server-side RPC used for all on-chain reads (balances, pools, receipts).
# Defaults to the public https://rpc.monad.xyz if unset.
MONAD_RPC_URL=
# Testnet RPC (defaults to https://testnet-rpc.monad.xyz).
MONAD_TESTNET_RPC_URL=
# Browser-visible RPC (used by the wallet client for reads in the browser).
NEXT_PUBLIC_MONAD_RPC_URL=
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=
# Optional override for the live token discovery list. Defaults to the official
# Monad token list on GitHub.
MONAD_TOKEN_LIST_URL=

# --- Alchemy -----------------------------------------------------------------
# Alchemy API key for Monad. Enables:
#   * RPC transport (server + optional browser RPC)
#   * Gas estimation / transaction preparation via the node
#   * The Alchemy Prices market-data source
# Get one at https://dashboard.alchemy.com/chains/monad
# Gas is always paid in MON by the standard EOA execution path; Alchemy is not
# used to sponsor or abstract gas.
ALCHEMY_API_KEY=
# Allow the browser to read chain state through Alchemy RPC. This is the SAME
# Alchemy key (Alchemy keys are designed for client use). Without it the browser
# reads through the public Monad RPC.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# --- Zerion ------------------------------------------------------------------
# Zerion API key (HTTP Basic Auth username, empty password) for wallet asset
# intelligence on Monad: discovered positions, metadata, and USD valuations.
# https://dashboard.zerion.io/
ZERION_API_KEY=
# Set to "0" to disable Zerion even when a key is present.
ZERION_ENABLED=

# --- Price providers ---------------------------------------------------------
# Primary market-data source (Alchemy Prices API) is enabled automatically when
# ALCHEMY_API_KEY is set. The keyless DEX sources below are the fallback chain.
# Override the GeckoTerminal network id (default "monad").
GECKOTERMINAL_NETWORK=
# Set to "0" to skip the DexScreener fallback.
DEXSCREENER_ENABLED=

# --- Execution protection ----------------------------------------------------
# Slippage tolerance (basis points) encoded into every swap as an on-chain
# amountOutMinimum / amountInMaximum. Defaults to 50 (0.5%) and is hard-clamped
# to 500 (5%) — slippage is never widened to force a bad route through.
NEXT_PUBLIC_SLIPPAGE_BPS=
# Maximum acceptable live price impact (basis points) for a route. A route above
# this is blocked before signing; slippage is never raised to rescue it.
# Defaults to 300 (3%). An unmeasurable impact does not block.
NEXT_PUBLIC_MAX_PRICE_IMPACT_BPS=
#
# NOTE: there is no MEV-protection configuration. Monad has no live private
# submission path, and a dapp cannot force an injected wallet to broadcast
# privately, so the app always reports "MEV Protection: Unavailable" honestly
# rather than faking an "Active" badge. See lib/domain/protection.ts.
#
# NOTE: there is no on-chain swap deadline either. SwapRouter02 (the router
# Monad deploys) has no `deadline` parameter, so a transaction cannot carry an
# on-chain expiry. Quote freshness is enforced off-chain: a stale quote is
# refused and the calldata rebuilt before signing (lib/domain/freshness,
# lib/execution/signGuard). See lib/execution/abis.ts.

# --- Natural-language intent (optional) --------------------------------------
# The Intent Engine parses payment sentences deterministically and works with
# none of these set. When an API key is present, an LLM may additionally *hint*
# at NLU fields the rules missed — it can never supply a price, route, address,
# or transaction. Leave blank to keep everything on-device/rule-based.
INTENT_LLM_API_KEY=
INTENT_LLM_BASE_URL=https://api.openai.com/v1
INTENT_LLM_MODEL=gpt-4o-mini

# --- Persistence -------------------------------------------------------------
# Referrals, payment-attempt correlation, ops events, cost accounting and the
# wallet session cookie all use a small server-side store (lib/store/*).
#
# DURABILITY MATTERS ONLY FOR REFERRALS. Referral attribution is meaningless if
# it cannot be remembered, so /api/referral/* REFUSE (503, storage_unavailable)
# unless the store is genuinely durable. Payment execution is unaffected: it
# never depends on the store, and no payment is blocked by a store outage.
#
# Backend selection (in priority order):
#
#   1. DATABASE_URL / INTENT_PAY_DATABASE_URL — a managed Postgres database
#      (Neon is the supported free option). THIS is the only genuinely durable
#      backend on Vercel, whose serverless filesystem is ephemeral. The schema is
#      migrated automatically on first use (idempotent, versioned migrations in
#      lib/store/migrations.ts). Use the pooled connection string.
#
#   2. INTENT_PAY_DB_PATH — an on-disk SQLite file (Node's built-in `node:sqlite`)
#      at the given path. Durable only on a real persistent volume; on a
#      serverless filesystem it is erased on a cold start.
#
#   3. neither — a temp-dir SQLite file, or in-memory when `node:sqlite` is
#      unavailable. Both are ephemeral.
#
# A configured URL is NOT proof of durable storage: /api/capabilities probes the
# database (a real query plus a schema-version check) and reports one of three
# honest states:
#   memory     — in-memory only (nothing survives a restart)
#   ephemeral  — a temp-dir SQLite file, or an unreachable / un-migrated database
#   persistent — a verified, reachable, migrated database
# Referral attribution is offered only in the `persistent` state. Nothing
# sensitive (no path, no credential) is ever returned by the capabilities probe.
#
# To enable durable referrals on Vercel at $0: create a Neon Free project, copy
# its POOLED connection string into DATABASE_URL, redeploy. Neon Free costs
# $0/month and does not bill overages (compute suspends at the monthly limit).
# See the deployment report for the exact limits.
DATABASE_URL=
INTENT_PAY_DATABASE_URL=
# Set INTENT_PAY_STORE=memory to force the in-memory adapter (e.g. edge runtimes).
INTENT_PAY_STORE=
INTENT_PAY_DB_PATH=

# --- Referral / ops administration (optional) --------------------------------
# Salt for the privacy-preserving click fingerprint (salted IP+UA+day hash).
# Change it per deployment; it is never treated as a hard identity.
INTENT_PAY_FINGERPRINT_SALT=
# Bearer token for the server-only ops/cost endpoints. When unset those
# endpoints are UNAVAILABLE (never open) — a missing secret must not mean "no
# auth required".
INTENT_PAY_ADMIN_TOKEN=
# Absolute origin used to build shareable referral links. Falls back to the
# Vercel-provided origin / NEXT_PUBLIC_SITE_URL when unset.
INTENT_PAY_PUBLIC_ORIGIN=

# --- AI cost accounting (optional) -------------------------------------------
# Monthly AI budget (USD) and an assumed request volume, used only to raise an
# ops alert as usage approaches the threshold. Token counts are recorded; the
# prompt and response are never stored.
INTENT_PAY_AI_MONTHLY_BUDGET_USD=
INTENT_PAY_ASSUMED_MONTHLY_REQUESTS=
# JSON price table override, e.g. {"gpt-4o-mini":{"input":0.15,"output":0.6}}
# (USD per 1M tokens). Unset uses the built-in table.
INTENT_PAY_LLM_PRICING=
