# ---------------------------------------------------------------------------
# Intent Pay — environment configuration
#
# Copy to `.env.local` and fill in what you have. Every value is optional: the
# app degrades gracefully (see the fallback notes) and never fakes data when a
# provider is missing.
# ---------------------------------------------------------------------------

# --- Monad -------------------------------------------------------------------
# Server-side RPC used for all on-chain reads (balances, pools, receipts).
# Defaults to the public https://rpc.monad.xyz if unset.
MONAD_RPC_URL=
# Testnet RPC (defaults to https://testnet-rpc.monad.xyz).
MONAD_TESTNET_RPC_URL=
# Browser-visible RPC (used by the wallet client for reads in the browser).
NEXT_PUBLIC_MONAD_RPC_URL=
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=
# Optional override for the live token discovery list. Defaults to the official
# Monad token list on GitHub.
MONAD_TOKEN_LIST_URL=

# --- Alchemy -----------------------------------------------------------------
# Alchemy API key for Monad. Enables:
#   * RPC transport (server + optional browser RPC)
#   * Gas estimation / transaction preparation via the node
#   * ERC-4337 Bundler + Gas Manager (paymaster) for gas abstraction
# Get one at https://dashboard.alchemy.com/chains/monad
ALCHEMY_API_KEY=
# Alchemy Gas Manager sponsorship policy id. When set (together with
# ALCHEMY_API_KEY) Intent Pay offers sponsored / ERC-20-gas payments through an
# EIP-5792-capable wallet. Without it, the app uses normal MON gas and says so.
# The id must be a Gas Manager policy UUID.
ALCHEMY_GAS_POLICY_ID=
# Optional policy window (unix seconds), mirroring the Gas Manager policy's
# startTimeUnix / endTimeUnix. When set, an expired policy is reported as
# expired rather than advertised as active. Leave unset to treat the policy as
# in-window.
ALCHEMY_GAS_POLICY_START_UNIX=
ALCHEMY_GAS_POLICY_END_UNIX=
# Comma-separated list of Monad token addresses the Gas Manager policy will
# sponsor. When set, the review screen can honestly name which pay assets are
# gas-abstracted; when empty, no individual token is claimed as sponsored.
ALCHEMY_PAYMASTER_TOKENS=
# Allow the browser to read chain state through Alchemy RPC and to build the
# ERC-7677 paymaster service URL handed to the wallet. This is the SAME Alchemy
# key (Alchemy keys are designed for client use); it must be exposed as
# NEXT_PUBLIC_* for the wallet to reach the paymaster. Without it, a configured
# paymaster cannot be used from the browser and the app falls back to MON gas.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# --- ERC-20 gas payment (Pimlico) -------------------------------------------
# Pimlico Bundler + ERC-20 paymaster. When set, a wallet holding USDC/USDT/…
# but 0 MON can pay the network fee in a token it already holds, through an
# EIP-7702 smart account that keeps the SAME address (no migration, no new
# wallet). The key is server-side only: the browser talks to the same-origin
# /api/aa/rpc and /api/aa/paymaster proxies, never to Pimlico directly.
# Get a key at https://dashboard.pimlico.io
PIMLICO_API_KEY=
# Chain the paymaster/bundler is served on. Defaults to 143 (Monad mainnet).
PIMLICO_CHAIN_ID=

# --- ZeroDEV (placeholder) ---------------------------------------------------
# Not used yet. Reserved for a future ERC-20 gas provider; the provider registry
# in lib/server/paymaster/index.ts is the single place a new provider is wired
# in. Leave unset.
ZERODEV_PROJECT_ID=

# --- Zerion ------------------------------------------------------------------
# Zerion API key (HTTP Basic Auth username, empty password) for wallet asset
# intelligence on Monad: discovered positions, metadata, and USD valuations.
# https://dashboard.zerion.io/
ZERION_API_KEY=
# Set to "0" to disable Zerion even when a key is present.
ZERION_ENABLED=

# --- Price providers ---------------------------------------------------------
# Primary market-data source (Alchemy Prices API) is enabled automatically when
# ALCHEMY_API_KEY is set. The keyless DEX sources below are the fallback chain.
# Override the GeckoTerminal network id (default "monad").
GECKOTERMINAL_NETWORK=
# Set to "0" to skip the DexScreener fallback.
DEXSCREENER_ENABLED=

# --- Execution protection ----------------------------------------------------
# Slippage tolerance (basis points) encoded into every swap as an on-chain
# amountOutMinimum / amountInMaximum. Defaults to 50 (0.5%) and is hard-clamped
# to 500 (5%) — slippage is never widened to force a bad route through.
NEXT_PUBLIC_SLIPPAGE_BPS=
# Maximum acceptable live price impact (basis points) for a route. A route above
# this is blocked before signing; slippage is never raised to rescue it.
# Defaults to 300 (3%). An unmeasurable impact does not block.
NEXT_PUBLIC_MAX_PRICE_IMPACT_BPS=
#
# NOTE: there is no MEV-protection configuration. Monad has no live private
# submission path, and a dapp cannot force an injected wallet to broadcast
# privately, so the app always reports "MEV Protection: Unavailable" honestly
# rather than faking an "Active" badge. See lib/domain/protection.ts.
#
# NOTE: there is no on-chain swap deadline either. SwapRouter02 (the router
# Monad deploys) has no `deadline` parameter, so a transaction cannot carry an
# on-chain expiry. Quote freshness is enforced off-chain: a stale quote is
# refused and the calldata rebuilt before signing (lib/domain/freshness,
# lib/execution/signGuard). See lib/execution/abis.ts.

# --- Natural-language intent (optional) --------------------------------------
# The Intent Engine parses payment sentences deterministically and works with
# none of these set. When an API key is present, an LLM may additionally *hint*
# at NLU fields the rules missed — it can never supply a price, route, address,
# or transaction. Leave blank to keep everything on-device/rule-based.
INTENT_LLM_API_KEY=
INTENT_LLM_BASE_URL=https://api.openai.com/v1
INTENT_LLM_MODEL=gpt-4o-mini
